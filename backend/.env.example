# ====================================================
# VEER SETU 🇮🇳 - Environment Security Configuration
# Never commit real secrets to public repositories!
# ====================================================

# Django Core Cryptographic Secret
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-cryptographically-random-64-char-string-in-prod
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,veersetu.gov.in

# MySQL Enterprise Database Configuration
DB_NAME=veersetu_sec_db
DB_USER=veersetu_db_user
DB_PASSWORD=SuperStrongComplexPassword#2026!
DB_HOST=127.0.0.1
DB_PORT=3306

# Security & Session Settings
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict
SESSION_COOKIE_AGE=900  # 15 minutes idle timeout (in seconds)

# Brute-Force Rate Limiting
MAX_LOGIN_FAILURES=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Private Document Storage Enclave (Outside Public Web Root)
PRIVATE_STORAGE_ROOT=/var/enclaves/veersetu/documents
MAX_UPLOAD_SIZE_BYTES=5242880  # 5 MB Maximum

